# =============================================================================
# Solar Energy Monitor — Stream Deck plugin
# =============================================================================
# The plugin itself stores ALL runtime configuration in Stream Deck settings
# (per key: service URL, optional auth header, metric, unit, refresh, style).
# It reads NO secrets from the environment and never logs credentials.
#
# This file documents the ONLY value you may want during local development:
# the base URL of your running energy-monitoring service. Copy to `.env` if you
# use it in your own dev tooling — the plugin does not require it.
#
# Never commit a real `.env`. Never put upstream tokens (Tesla / SolaX / Shelly
# cloud / Tapo) here — those belong to the energy-monitoring service, not this
# plugin.

# Base URL of the local energy-monitoring service (as reachable from this PC).
ENERGY_SERVICE_URL=http://localhost:3000

# Optional Authorization header value, ONLY if you front the service with a
# reverse proxy that requires auth (e.g. "Bearer xxxxx" or "Basic xxxxx").
# Leave empty for a plain local service (the service has no auth by default).
ENERGY_AUTH_HEADER=
